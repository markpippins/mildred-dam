[TEMPLATE]
# mildred-ui runtime mode
#   mock = serve in-memory mock data on port 3000 (default — no .env file needed)
#   live = proxy all requests to mildred-service:3140 on port 4213, with stubs for endpoints not yet on the backend
VITE_MILDRED_MODE=mock

# Override the backend target when VITE_MILDRED_MODE=live
# VITE_MILDRED_TARGET=http://localhost:3140

# Override the default port (mock=3000, live=4213)
# PORT=3000

# Gemini API key (used only in mock mode for live AI test invocations)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
